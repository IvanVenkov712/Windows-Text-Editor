/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDM_MAINMENU MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "New\tCtrl+N",                 ID_FILE_NEW
        MENUITEM "New Window\tCtrl+Shift+N",    ID_FILE_NEWWINDOW
        MENUITEM "Open\tCtrl+O",                ID_FILE_OPEN
        MENUITEM "Save\tCtrl+S",                ID_FILE_SAVE, INACTIVE
        MENUITEM "Save as\tCtrl+Shift+S",       ID_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        ID_FILE_EXIT
    END
    POPUP "Edit"
    BEGIN
        MENUITEM "Undo\tCtrl+Z",                ID_EDIT_UNDO
        MENUITEM "Cut\tCtrl+X",                 ID_EDIT_CUT, INACTIVE
        MENUITEM "Copy\tCtrl+C",                ID_EDIT_COPY, INACTIVE
        MENUITEM "Paste\tCtrl+V",               ID_EDIT_PASTE
        MENUITEM "Delete\tDel",                 ID_EDIT_DELETE, INACTIVE
        MENUITEM SEPARATOR
        MENUITEM "Replace\tCtrl+H",             ID_EDIT_REPLACE
        MENUITEM "Find\tCtrl+F",                ID_EDIT_FIND
        MENUITEM "Go to\tCtrl+G",               ID_EDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Select all\tCtrl+A",          ID_EDIT_SELECTALL
        MENUITEM "Hour/Date\tF5",               ID_EDIT_HOUR
    END
    POPUP "Format"
    BEGIN
        MENUITEM "Word Wrap",                   ID_FORMAT_WORDWRAP
        MENUITEM "Font",                        ID_FORMAT_FONT
    END
    POPUP "View"
    BEGIN
        POPUP "Zoom"
        BEGIN
            MENUITEM "Zoom In\tCtrl+Plus",          ID_VIEW_ZOOMIN
            MENUITEM "Zoom Out\tCtrl+Minus",        ID_VIEW_ZOOMOUT
            MENUITEM "Restore Default Zoom\tCtrl+0", ID_VIEW_RESTOREZOOM
        END
        MENUITEM "Status bar",                  ID_VIEW_STATUSBAR, CHECKED
    END
    POPUP "Help"
    BEGIN
        MENUITEM "About",                       ID_HELP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_F5,          ID_ACCELDATEHOUR,       VIRTKEY, NOINVERT
    "F",            ID_ACCELFIND,           VIRTKEY, CONTROL, NOINVERT
    "G",            ID_ACCELGOTO,           VIRTKEY, CONTROL, NOINVERT
    "N",            ID_ACCELNEW,            VIRTKEY, CONTROL, NOINVERT
    "N",            ID_ACCELNEWWINDOW,      VIRTKEY, SHIFT, CONTROL, NOINVERT
    "O",            ID_ACCELOPEN,           VIRTKEY, CONTROL, NOINVERT
    VK_NUMPAD0,     ID_ACCELRESTOREZOOM1,   VIRTKEY, CONTROL, NOINVERT
    "0",            ID_ACCELRESTOREZOOM2,   VIRTKEY, CONTROL, NOINVERT
    "S",            ID_ACCELSAVE,           VIRTKEY, CONTROL, NOINVERT
    "S",            ID_ACCELSAVEAS,         VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_OEM_MINUS,   ID_ACCELZOOMDEC1,       VIRTKEY, CONTROL, NOINVERT
    VK_SUBTRACT,    ID_ACCELZOOMDEC2,       VIRTKEY, CONTROL, NOINVERT
    VK_ADD,         ID_ACCELZOOMINC1,       VIRTKEY, CONTROL, NOINVERT
    VK_OEM_PLUS,    ID_ACCELZOOMINC2,       VIRTKEY, CONTROL, NOINVERT
    "H",            ID_ACCELREPLACE,        VIRTKEY, CONTROL, NOINVERT
END


